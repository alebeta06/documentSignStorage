# Copia este archivo a sc/.env y completa los valores reales.
# sc/.env esta en .gitignore — nunca se commitea.

# RPC HTTPS de Sepolia (Alchemy / Infura / publico).
# Ejemplo Alchemy: https://eth-sepolia.g.alchemy.com/v2/TU_ALCHEMY_KEY
SEPOLIA_RPC_URL=

# RPC HTTPS de Base Sepolia (se usa en Fase 2b).
# Alchemy: https://base-sepolia.g.alchemy.com/v2/TU_ALCHEMY_KEY
# Publico: https://sepolia.base.org
BASE_SEPOLIA_RPC_URL=

# Private key (con 0x al inicio) de la wallet deployer.
# Esta wallet debe tener Sepolia ETH y Base Sepolia ETH.
# NUNCA usar una cuenta con ETH real de mainnet.
DEPLOYER_PRIVATE_KEY=

# Etherscan API key — opcional.
# Si esta vacio, deployamos verificando con Sourcify (no requiere key).
ETHERSCAN_API_KEY=
